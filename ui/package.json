  "author": "pratikpatelpp802@gmail.com",
  "description": "QHierarchy: a fast tree grid (hierarchical data table) for Quasar and Vue 3, with virtual scrolling, tri-state selection, lazy loading and keyboard navigation",
  "license": "MIT",
  "module": "dist/index.esm.js",
  "main": "dist/index.common.js",
  "unpkg": "dist/index.umd.min.js",
  "jsdelivr": "dist/index.umd.min.js",
  "style": "dist/index.css",
  "sideEffects": [
    "*.css",
    "*.vue"
  ],
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "scripts": {
    "build": "node build/index.js",
    "dev": "npm --prefix ../demo run dev",
    "dev:umd": "npm run build && node build/script.open-umd.js"
  },
  "homepage": "https://next-quasar-qhierarchy.netlify.app/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pratik227/quasar-qhierarchy.git"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/pratik227"
  },
  "bugs": "https://github.com/pratik227/quasar-qhierarchy/issues",
  "keywords": [
    "quasar",
    "quasarframework",
    "vue",
    "vue3",
    "tree",
    "treegrid",
    "tree-table",
    "hierarchy",
    "table",
    "virtual-scroll"
  ],
  "peerDependencies": {
    "quasar": "^2.0.0",
    "vue": "^3.2.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.10",
    "quasar": "^2.35.2",
    "vite": "^8.3.5",
    "vue": "^3.5.44"
  }
}
